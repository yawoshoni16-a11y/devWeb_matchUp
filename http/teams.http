###
# Admin LOGIN 
# @name user_login
POST http://localhost:3000/auth/login HTTP/1.1
Content-Type: application/json

{
    "username" : "admin",
    "password" : "admin"
}

###
# Referee LOGIN
# @name user_login
POST http://localhost:3000/auth/login HTTP/1.1
Content-Type: application/json

{
    "username" : "ref",
    "password" : "ref"
}

